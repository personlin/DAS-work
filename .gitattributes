# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Source and project metadata.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.python-version text eol=lf

# Scripts.
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary scientific/data artifacts.
*.h5 binary
*.hdf5 binary
*.tdms binary
*.sgy binary
*.segy binary
*.npy binary
*.npz binary
*.parquet binary
*.feather binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
*.bz2 binary
*.xz binary
